# Docker Hub 固定版本镜像；更新前备份资料，再明确改为新版本号。
# 源码构建使用 compose.build.yaml，此项不参与构建。
GRAVELLE_IMAGE=pumpkissster/gravelle:1.8.2

# 宿主机允许访问的写真根目录；变量名 COMICS_PATH 为兼容保留。
# 容器内为 /library，只读。网页中选择 /library 或其子目录。
COMICS_PATH=/volume1/comics

# 写真库、作品资料、模特、书签、阅读记录与收藏的保存目录。
# 启动前创建并赋予运行用户读写权限。
DATA_PATH=/volume1/docker/sumi-reader/data

# 在宿主机运行 id 你的用户名，填写实际 uid 和 gid。
PUID=1000
PGID=1000

# 浏览器访问 http://服务器IP:8080；占用时改成其他端口。
WEB_PORT=8080

# 可选的首次注册保护密码。网页首次访问需创建个人账户，之后以用户名和密码登录。
# 旧版已经设置该变量的用户，注册时还需输入原访问密码；账户创建后此变量不再用于登录。
# 留空仅表示注册时不需要额外保护密码，不会启用免密访问。
# 含 $ 或 # 时用单引号包住值，例如 READER_PASSWORD='your-long-password'。
READER_PASSWORD=

# 已配置媒体库的后台扫描间隔，单位秒；0 表示禁用定时扫描。
SCAN_INTERVAL=300

# 检查更新的公开 GitHub 仓库，格式为 owner/repository。
# 仅用于源码构建；正式镜像中已内置发布仓库。
GRAVELLE_RELEASE_REPOSITORY=pumpkissster/gravelle
